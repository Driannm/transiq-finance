generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ─────────────────────────────────────

enum Role {
  PARENT
  CHILD
}

enum CardType {
  BANK
  EMONEY
  EWALLET
  PAYLATER
}

enum BillingRuleType {
  MONTHLY_CUTOFF_OFFSET_DUE
  MONTHLY_CUTOFF_DAYS_DUE
}

enum BillStatus {
  OPEN
  PAID
  OVERDUE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT
  LOAN
}

enum DebtLoanStatus {
  ACTIVE
  PAID
  OVERDUE
}

// ─── USER & FAMILY ─────────────────────────────

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(PARENT)

  familyId  String?
  family    Family?   @relation(fields: [familyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // [FIX #1] Soft delete

  cards        Card[]
  transactions Transaction[]
  assets       Asset[]
  groups       TransactionGroup[]
  savings      Saving[]
  bills        Bill[]
  expenseTemplates ExpenseTemplate[]

  @@index([familyId])
  @@map("users")
}

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members    User[]
  cards      Card[]
  assets     Asset[]
  categories Category[]
  merchants  Merchant[]
  savings      Saving[]
  bills        Bill[]
  groups     TransactionGroup[]

  @@map("families")
}

// ─── FINANCIAL CORE ────────────────────────────

model Card {
  id      String   @id @default(cuid())
  name    String
  type    CardType
  balance Float    @default(0)

  // [NOTE] Balance disimpan sebagai cache.
  // Selalu hitung ulang dari aggregate transaksi untuk validasi.
  // Gunakan lastReconciledAt untuk tahu kapan terakhir diverifikasi.
  lastReconciledAt DateTime?

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // [FIX #1] Soft delete

  dueType   BillingRuleType?
  cutoffDay Int?
  dueOffset Int?
  dueDay    Int?
  timezone  String?          @default("Asia/Jakarta")

  transactions  Transaction[]
  transfersTo   Transfer[]    @relation("ToCard")
  transfersFrom Transfer[]    @relation("FromCard")
  bills         Bill[]
  expenseTemplates ExpenseTemplate[]

  @@index([userId])
  @@index([familyId])
  @@map("cards")
}

// ─── TRANSACTION MASTER ─────────────────────────

model Transaction {
  id     String          @id @default(cuid())
  amount Float
  type   TransactionType
  date   DateTime        @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  cardId String
  card   Card   @relation(fields: [cardId], references: [id])

  // Sub-Model Relations (1-to-1)
  expense  Expense?
  income   Income?
  transfer Transfer?
  debt     Debt?
  loan     Loan?

  // Relasi ke/dari Bill
  billId   String?
  bill     Bill?           @relation(fields: [billId], references: [id])

  // [FEATURE] Group Transaction
  groups TransactionGroupItem[]

   // Relasi timbal balik untuk pencatatan pembayaran utang (1:1)
  debtPayment DebtPayment?
  loanPayment LoanPayment?

  createdAt DateTime  @default(now())
  deletedAt DateTime? // [FIX #1] Soft delete

  @@index([userId, date])
  @@index([cardId, date])
  @@index([type])
  @@index([deletedAt, date])
  @@map("transactions")
}

// ─── TRANSACTION SUB-MODELS ─────────────────────

model Expense {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  name       String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  tax      Float?  @default(0)
  fee      Float?  @default(0)
  discount Float?  @default(0)
  notes    String?

  @@index([categoryId])
  @@index([merchantId])
  @@map("expenses")
}

model Income {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  name   String
  source String?
  notes  String?

  @@map("incomes")
}

model Transfer {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // [FIX #3] fromCardId dihapus — sudah tersimpan di Transaction.cardId
  // Transaction.cardId  = kartu pengirim (from)
  // Transfer.toCardId   = kartu penerima (to)
  toCardId String
  toCard   Card   @relation("ToCard", fields: [toCardId], references: [id])

  // Relasi fromCard tetap ada untuk kemudahan query, tapi via Transaction
  fromCardId String
  fromCard   Card   @relation("FromCard", fields: [fromCardId], references: [id])

  fee Float? @default(0)

  @@map("transfers")
}

model Debt {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  personName  String
  description String?
  dueDate     DateTime?
  status      DebtLoanStatus @default(ACTIVE)
  category    String         @default("other") // "personal" | "credit_card" | "bank" | "family" | "other"
  installment Boolean        @default(false)

  payments DebtPayment[]

  @@index([status])
  @@map("debts")
}

model DebtPayment {
  id     String @id @default(cuid())
  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  paidAt        DateTime    @default(now())
  notes         String?

  @@map("debt_payments")
}

model Loan {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  personName  String
  description String?
  dueDate     DateTime?
  status      DebtLoanStatus @default(ACTIVE)
  category    String         @default("personal") // "personal" | "family" | "colleague" | "other"
  loanDate    DateTime       @default(now())

  // [FIX #4] Relasi ke payment transactions
  payments LoanPayment[]

  @@index([status])
  @@map("loans")
}

model LoanPayment {
  id     String @id @default(cuid())
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id])

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  paidAt        DateTime @default(now())
  notes         String?

  @@map("loan_payments")
}

// ─── GROUP TRANSACTION ──────────────────────────
// [FEATURE] Grouping adalah layer tambahan — tidak memodifikasi transaksi asli.
// Relasi many-to-many via tabel junction TransactionGroupItem.

model TransactionGroup {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Kustomisasi tampilan (icon & warna dari daftar yang tersedia di aplikasi)
  icon        String  // Nama icon dari daftar preset, e.g. "airplane", "cart", "home"
  iconColor   String  // Kode warna dari daftar preset, e.g. "#FF5733"

  // Ownership — group milik user, opsional di-share ke keluarga
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // [FIX #1] Soft delete

  items TransactionGroupItem[]

  @@index([userId])
  @@index([familyId])
  @@map("transaction_groups")
}

// Tabel junction many-to-many: 1 transaksi bisa di banyak group, 1 group punya banyak transaksi
model TransactionGroupItem {
  id      String @id @default(cuid())
  groupId String
  group   TransactionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  // Pastikan 1 transaksi tidak duplikat dalam 1 group
  @@unique([groupId, transactionId])
  @@index([groupId])
  @@index([transactionId])
  @@map("transaction_group_items")
}

// ─── OTHERS ────────────────────────────────────

model Asset {
  id        String  @id @default(cuid())
  name      String
  value     Float?
  ownerName String
  // [FIX #7] Tambah kategori aset untuk filter di dashboard
  category  String? // e.g. "property", "vehicle", "investment", "savings"

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // [FIX #1] Soft delete

  @@index([userId])
  @@index([familyId])
  @@map("assets")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // [FIX #2] Relasi proper ke Family (sebelumnya hanya String tanpa relasi)
  familyId String
  family   Family @relation(fields: [familyId], references: [id])

  expenses Expense[]
  expenseTemplates ExpenseTemplate[]

  @@index([familyId])
  @@map("categories")
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // [FIX #2] Relasi proper ke Family (sebelumnya hanya String tanpa relasi)
  familyId String
  family   Family @relation(fields: [familyId], references: [id])

  expenses Expense[]
  expenseTemplates ExpenseTemplate[]

  @@index([familyId])
  @@map("merchants")
}

model Saving {
  id          String   @id @default(cuid())
  name        String
  targetAmount Float
  savedAmount  Float    @default(0)
  dueDate      DateTime?
  
  // Relasi ke User/Family pemilik
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  familyId    String?
  family      Family?  @relation(fields:[familyId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("savings")
}
  
model Bill {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  dueDate     DateTime
  status      BillStatus @default(OPEN)
  
  // Relasi ke User/Family pemilik
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  familyId    String?
  family      Family?  @relation(fields: [familyId], references: [id])

  // Context & Metadata
  category            String?    // e.g. "utilities", "subscription", etc.
  payee               String?    // e.g. "PLN", "IndiHome"
  recurring           Boolean    @default(false)
  notes               String?
  deletedAt           DateTime?  // Soft delete

  // Snapshots dan Relasi Paylater
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  cardId             String?
  card               Card?            @relation(fields: [cardId], references: [id])

  transactions       Transaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cardId, billingPeriodStart, billingPeriodEnd])
  @@index([userId, deletedAt])
  @@index([familyId, deletedAt])
  @@index([deletedAt, dueDate])
  @@map("bills")
}

model ExpenseTemplate {
  id          String   @id @default(cuid())
  name        String   // Nama identitas template
  amount      Float    // Nominal pokok
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  merchantId  String?
  merchant    Merchant? @relation(fields: [merchantId], references: [id])
  
  cardId      String?
  card        Card?     @relation(fields: [cardId], references: [id])
  
  tax         Float?    @default(0)
  fee         Float?    @default(0)
  discount    Float?    @default(0)
  notes       String?
  
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("expense_templates")
}