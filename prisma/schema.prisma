generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ─────────────────────────────────────

enum Role {
  PARENT
  CHILD
}

enum CardType {
  BANK
  EMONEY
  EWALLET
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT
  LOAN
}

enum DebtLoanStatus {
  ACTIVE
  PAID
  OVERDUE
}

// ─── USER & FAMILY ─────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PARENT)

  // Hubungan ke Keluarga (Opsional)
  familyId  String?
  family    Family?  @relation(fields: [familyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards        Card[]
  transactions Transaction[]
  assets       Asset[]
}

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members   User[]
  cards     Card[]
  assets    Asset[]
}

// ─── FINANCIAL CORE ────────────────────────────

model Card {
  id             String   @id @default(cuid())
  name           String
  type           CardType
  balance        Float    @default(0)

  // Ownership
  userId         String   // Pemilik asli
  user           User     @relation(fields: [userId], references: [id])
  familyId       String?  // Jika diisi, kartu ini shared ke keluarga
  family         Family?  @relation(fields: [familyId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions   Transaction[]
  transfersTo    Transfer[]    @relation("ToCard")
  transfersFrom  Transfer[]    @relation("FromCard")
}

// ─── TRANSACTION MASTER ─────────────────────────

model Transaction {
  id          String          @id @default(cuid())
  amount      Float
  type        TransactionType
  date        DateTime        @default(now())
  
  // Relasi Konten
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  cardId      String
  card        Card            @relation(fields: [cardId], references: [id])

  // Sub-Model Relations (1-to-1)
  expense     Expense?
  income      Income?
  transfer    Transfer?
  debt        Debt?
  loan        Loan?

  createdAt   DateTime        @default(now())
}

// ─── TRANSACTION SUB-MODELS ─────────────────────

model Expense {
  id            String   @id @default(cuid())
  transactionId String   @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  name          String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id])
  
  // Breakdown (Opsional)
  tax           Float?   @default(0)
  fee           Float?   @default(0)
  discount      Float?   @default(0)
  notes         String?
}

model Income {
  id            String   @id @default(cuid())
  transactionId String   @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  name          String
  source        String?
  notes         String?
}

model Transfer {
  id            String   @id @default(cuid())
  transactionId String   @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  fromCardId    String
  fromCard      Card     @relation("FromCard", fields: [fromCardId], references: [id])
  toCardId      String
  toCard        Card     @relation("ToCard", fields: [toCardId], references: [id])
  
  fee           Float?   @default(0)
}

model Debt {
  id            String   @id @default(cuid())
  transactionId String   @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  personName    String   // Berhutang ke siapa
  description   String?
  dueDate       DateTime?
  status        DebtLoanStatus @default(ACTIVE)
}

model Loan {
  id            String   @id @default(cuid())
  transactionId String   @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  personName    String   // Siapa yang pinjam uang kita
  description   String?
  dueDate       DateTime?
  status        DebtLoanStatus @default(ACTIVE)
}

// ─── OTHERS ────────────────────────────────────

model Asset {
  id        String   @id @default(cuid())
  name      String
  value     Float?
  ownerName String   // Sesuai dokumen resmi

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  familyId  String?
  family    Family?  @relation(fields: [familyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  familyId  String
  createdAt DateTime @default(now())

  expenses Expense[]
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  familyId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
}